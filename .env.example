# Local, single-user development only. Copy to .env and choose your own token.
VEYRA_DEV_TOKEN=replace-with-a-long-random-local-token
# Optional separate read-only principal. Leave empty to disable.
VEYRA_VIEWER_TOKEN=
DATABASE_URL=postgresql://veyra:veyra-local@127.0.0.1:5432/veyra
POSTGRES_PASSWORD=veyra-local
API_INTERNAL_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:3000
# Server-side Meta credentials; never prefix with NEXT_PUBLIC_.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Cloud inference is disabled until both monetary reservation limits are configured.
# These are operator-set ceilings/estimates, not a statement of Meta's prices.
MODEL_DAILY_REQUESTS=100
MODEL_DAILY_BUDGET_USD=0
MODEL_REQUEST_RESERVE_USD=0
# Optional account-verified prices for token-based cost estimates; actual billing stays unknown.
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=
INDEXING_SAMPLE_MS=500
INDEXING_CLIP_MS=10000
INDEXING_MOTION_THRESHOLD=0.035
# Only Standard mode is selected. Cloud video upload needs per-camera consent.
# Pull source example after explicitly authorizing its exact LAN address:
# CAMERA_ALLOWED_CIDRS=192.168.1.10/32
# CAMERA_SOURCES_JSON={"entrance":{"mode":"pull","url":"rtsp://192.168.1.10:554/stream"}}
CAMERA_ALLOWED_CIDRS=
CAMERA_ALLOWED_PORTS=554,8554
CAMERA_SOURCES_JSON={}
# Explicit synthetic source; never substitutes for a disconnected real device.
ENABLE_SAMPLE_CAMERA=true
SAMPLE_CAMERA_COUNT=1
# Server-only HLS proxy/CDN secret, distinct from the API token. Compose requires this.
MEDIAMTX_HLS_SECRET=replace-with-a-separate-long-random-secret
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
RECORDINGS_ROOT=runtime/recordings
PLAYBACK_CACHE_ROOT=runtime/playback-cache
# Compose overrides media URLs, paths, and egress manifest. Native sample needs no pull guard.
# MEDIA_EGRESS_GUARD_FILE=/media-policy/installed.json
