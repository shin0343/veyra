  {
    "availability": "available",
    "backend_handler": "agent_tools.create_layout",
    "confirmation": "always",
    "description": "Propose a saved layout using the user's camera names in row-major order. Server resolves names. Always pauses for user confirmation before any write. For a 2x2 view use columns=2 and four cameras. Only use camera_id when the user explicitly supplied that UUID.",
    "effect": "write",
    "implemented": true,
    "input_schema": {
      "$defs": {
        "CameraSelection": {
          "additionalProperties": false,
