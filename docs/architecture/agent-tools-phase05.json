[
  {
    "availability": "available",
    "backend_handler": "agent_tools.search_video",
    "confirmation": "never",
    "description": "Search actual stored video indexes. Parse user intent into bounded camera names, UTC times, same-object attributes, observable event types, motion_only and residual caption keywords. Use no duplicate filler keywords. Supply null bounds when unspecified. Bind clothing colors to apparel kind/colors on the same person. Do not mix garment colors. Identity, demographics and intent are unsupported. Never invent matching timestamps. Use only structured constraints; no SQL, URLs, paths or code. Does not analyze video. For supported searches OMIT unsupported_reason; never send 'none' or ''. OMIT start/end when unspecified; never send empty strings. Example objects: [{\"category\":\"bicycle\",\"attributes\":[],\"apparel\":[]}]. Use arrays for camera_names/event_types/keywords, boolean false for motion_only unless requested, and include all required fields exactly as declared in the schema.",
    "effect": "read",
    "implemented": true,
    "input_schema": {
      "$defs": {
        "Apparel": {
          "additionalProperties": false,
          "properties": {
            "colors": {
              "items": {
                "enum": [
                  "red",
                  "blue",
                  "green",
                  "yellow",
                  "orange",
                  "purple",
                  "pink",
                  "black",
                  "white",
                  "gray",
                  "brown"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "title": "Colors",
              "type": "array"
            },
            "kind": {
              "enum": [
                "jacket",
                "shirt",
                "pants",
                "shorts",
                "hat",
                "helmet",
                "backpack"
              ],
              "title": "Kind",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "colors"
          ],
          "title": "Apparel",
          "type": "object"
        },
        "ObjectConstraint": {
          "additionalProperties": false,
          "properties": {
            "apparel": {
              "items": {
                "$ref": "#/$defs/Apparel"
              },
              "maxItems": 8,
              "title": "Apparel",
              "type": "array"
            },
            "attributes": {
              "items": {
                "enum": [
                  "red",
                  "blue",
                  "green",
                  "yellow",
                  "orange",
                  "purple",
                  "pink",
                  "black",
                  "white",
                  "gray",
                  "brown",
                  "jacket",
                  "shirt",
                  "pants",
                  "shorts",
                  "hat",
                  "helmet",
                  "backpack",
                  "moving",
                  "stationary",
                  "open",
                  "closed"
                ],
                "type": "string"
              },
              "maxItems": 12,
              "title": "Attributes",
              "type": "array"
            },
            "category": {
              "enum": [
                "person",
                "bicycle",
                "motorcycle",
                "car",
                "truck",
                "bus",
                "dog",
                "cat",
                "bird",
                "bag",
                "package",
                "door",
                "other"
              ],
              "title": "Category",
              "type": "string"
            }
          },
          "required": [
            "category",
            "attributes"
          ],
          "title": "ObjectConstraint",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "camera_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Camera Ids",
          "type": "array"
        },
        "camera_names": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Camera Names",
          "type": "array"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "event_types": {
          "items": {
            "enum": [
              "person_visible",
              "vehicle_visible",
              "animal_visible",
              "walking",
              "running",
              "cycling",
              "object_carried",
              "door_movement"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Event Types",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Keywords",
          "type": "array"
        },
        "limit": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "motion_only": {
          "title": "Motion Only",
          "type": "boolean"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/ObjectConstraint"
          },
          "maxItems": 8,
          "title": "Objects",
          "type": "array"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "enum": [
                "identity",
                "demographics",
                "intent",
                "ambiguous_time",
                "unsupported_constraint"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Reason"
        }
      },
      "required": [
        "camera_names",
        "objects",
        "event_types",
        "motion_only",
        "keywords"
      ],
      "title": "SearchVideo",
      "type": "object"
    },
    "name": "video.search",
    "navigation_destination": "recording",
    "permission": "vms:read"
  },
